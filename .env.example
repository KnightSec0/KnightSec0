# =============================================================================
# DeepVault Environment Configuration
# Copy this to .env and fill in your values
# =============================================================================

# REQUIRED: Breach Detection APIs
INTELX_API_KEY=your_intelx_api_key
DEHASHED_API_KEY=your_dehashed_api_key
DEHASHED_API_LOGIN=your_dehashed_email@example.com

# STRONGLY RECOMMENDED: Data Enrichment
HIBP_API_KEY=your_hibp_api_key
HUNTER_API_KEY=your_hunter_api_key
SHODAN_API_KEY=your_shodan_api_key
BRAVE_API_KEY=your_brave_search_api_key

# OPTIONAL: Advanced Intelligence
SOCIALLINKS_API_KEY=your_sociallinks_api_key
VIRUSTOTAL_API_KEY=your_virustotal_api_key

# DATABASE CONFIGURATION
POSTGRES_USER=deepvault
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=deepvault_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# NEO4J CONFIGURATION
NEO4J_AUTH=neo4j/change_this_secure_password
NEO4J_HOST=neo4j
NEO4J_PORT=7687

# REDIS CONFIGURATION
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_secure_password

# MINIO (S3) CONFIGURATION
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_secure_password
MINIO_ENDPOINT=minio:9000

# ELASTICSEARCH CONFIGURATION
ELASTICSEARCH_HOSTS=elasticsearch:9200

# TOR CONFIGURATION
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051

# APPLICATION SETTINGS
DEEPVAULT_API_PORT=8080
DEEPVAULT_ENVIRONMENT=production
DEEPVAULT_LOG_LEVEL=INFO

# SECURITY
SECRET_KEY=generate_a_random_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1
