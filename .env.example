# =============================================================================
# DeepVault Environment Configuration
# Copy this to .env and fill in your values
# =============================================================================

# --- Database ---
DB_PASSWORD=changeme_prod_use_openssl_rand
NEO4J_PASSWORD=changeme_prod_use_openssl_rand

# --- Storage (MinIO S3-compatible) ---
MINIO_ROOT_USER=deepvault
MINIO_ROOT_PASSWORD=changeme_prod_use_openssl_rand

# --- API Keys ---
# Intelligence X: https://intelx.io (dark web + breach + paste search)
INTELX_API_KEY=

# DeHashed: https://dehashed.com (breach database)
DEHASHED_API_KEY=
DEHASHED_API_LOGIN=

# Have I Been Pwned: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Hunter.io: https://hunter.io (email pattern discovery)
HUNTER_API_KEY=

# Shodan: https://shodan.io (IP/device reconnaissance)
SHODAN_API_KEY=

# Brave Search: https://brave.com/search/api/
BRAVE_API_KEY=

# SocialLinks: https://sociallinks.io (social media + dark web intel)
SOCIALLINKS_API_KEY=

# --- Tor ---
TOR_PROXY=socks5://tor-proxy:9050

# --- Celery / Redis ---
CELERY_BROKER=redis://redis:6379/0
