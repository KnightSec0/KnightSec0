# =============================================================================
# DeepVault Environment Configuration
# Copy this to .env and fill in your values
# =============================================================================

# --- Database ---
# Changing DB_PASSWORD after PostgreSQL first initializes does not rotate the
# stored database role password. See docs/PERSON_OSINT.md for the safe sync step.
DB_PASSWORD=changeme_prod_use_openssl_rand
NEO4J_PASSWORD=changeme_prod_use_openssl_rand

# --- Storage (MinIO S3-compatible) ---
MINIO_ROOT_USER=deepvault
MINIO_ROOT_PASSWORD=changeme_prod_use_openssl_rand

# --- API Keys ---
# Intelligence X: https://intelx.io (dark web + breach + paste search)
INTELX_API_KEY=

# DeHashed: https://dehashed.com (breach database)
DEHASHED_API_KEY=
DEHASHED_API_LOGIN=

# Have I Been Pwned: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Hunter.io: https://hunter.io (email pattern discovery)
HUNTER_API_KEY=

# Shodan: https://shodan.io (IP/device reconnaissance)
SHODAN_API_KEY=

# Censys: https://search.censys.io/api
CENSYS_API_ID=
CENSYS_API_SECRET=

# Brave Search: https://brave.com/search/api/
BRAVE_API_KEY=

# GitHub: optional; increases public API rate limits
GITHUB_TOKEN=

# Gravatar: optional for public profile enrichment
GRAVATAR_API_KEY=

# Optional local SpiderFoot API endpoint
SPIDERFOOT_URL=

# SocialLinks: https://sociallinks.io (social media + dark web intel)
SOCIALLINKS_API_KEY=

# --- Tor ---
TOR_PROXY=socks5://tor-proxy:9050

# --- Celery / Redis ---
CELERY_BROKER=redis://redis:6379/0

# --- Person OSINT intelligence / reporting ---
# none | openai | anthropic | gemini | ollama | openai-compatible
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=default
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.3
LLM_CONSENSUS_PROVIDERS=

# Keep raw names, emails and usernames out of external LLM prompts by default.
LLM_INCLUDE_IDENTIFIERS=false

# Connector resource limits
CONNECTOR_TIMEOUT=30
MAX_OSINT_CONCURRENCY=4
RUNNING_TASK_STALE_SECONDS=3600
PERSON_OSINT_SOURCES=github,gravatar,hibp,hunter,brave,sherlock,maigret,holehe,spiderfoot,shodan,censys

# Dark-web, geolocation and financial pivots are opt-in.
ALLOW_SENSITIVE_PIVOTS=false

# Shodan/Censys also require per-case consent and literal authorized IPs.
ALLOW_INFRASTRUCTURE_ENRICHMENT=false
AUTHORIZATION_REFERENCE=
